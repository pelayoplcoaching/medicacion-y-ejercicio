{
  "clases": [
    {
      "id": "estimulantes_tdah",
      "nombre": "Estimulantes para el TDAH (metilfenidato, lisdexanfetamina) y atomoxetina",
      "atc": [
        "N06BA"
      ],
      "resumen": "Aceleran el pulso y suben algo la tensión. El ejercicio es seguro y suele mejorar los síntomas del TDAH; el pulso no es buena guía de intensidad mientras hacen efecto.",
      "senales": [
        "taquicardia",
        "hipertension",
        "fc_no_valida",
        "calor"
      ],
      "principios": [
        {
          "id": "metilfenidato",
          "nombre": "Metilfenidato",
          "marcas": [
            "Concerta",
            "Medikinet",
            "Rubifen",
            "Equasym"
          ],
          "umbral_mg": {
            "alta": 54
          }
        },
        {
          "id": "lisdexanfetamina",
          "nombre": "Lisdexanfetamina",
          "marcas": [
            "Elvanse"
          ],
          "umbral_mg": {
            "alta": 50
          }
        },
        {
          "id": "atomoxetina",
          "nombre": "Atomoxetina",
          "marcas": [
            "Strattera"
          ],
          "umbral_mg": {
            "alta": 80
          }
        }
      ],
      "general": [
        {
          "nivel": "info",
          "texto": "El pulso y la tensión están algo elevados mientras dura el efecto: use la sensación de esfuerzo para medir la intensidad. Palpitaciones intensas o dolor en el pecho con el esfuerzo: pare y consulte.",
          "fuente": "ACSM GETP 11.ª ed., ap. A",
          "evidencia": "guia",
          "revisado": true
        },
        {
          "nivel": "precaucion",
          "texto": "Reducen la sensación de sed y de fatiga y favorecen el sobrecalentamiento: beba por horario (no por sed) y evite el ejercicio intenso con calor.",
          "fuente": "FT AEMPS 4.4",
          "evidencia": "ft",
          "revisado": true
        },
        {
          "nivel": "info",
          "texto": "Si el apetito está reducido, asegúrese de comer antes de entrenar; muchos deportistas lo toman después del entrenamiento matinal.",
          "fuente": "FT AEMPS 4.4",
          "evidencia": "ft",
          "revisado": true
        }
      ],
      "aerobico": [
        {
          "nivel": "info",
          "texto": "Puede hacer ejercicio aeróbico. Si compite, consulte la normativa antidopaje: estos fármacos necesitan una autorización de uso terapéutico.",
          "fuente": "FT AEMPS 4.4",
          "evidencia": "ft",
          "revisado": true
        }
      ],
      "fuerza": [
        {
          "nivel": "info",
          "texto": "Sin limitación.",
          "fuente": "FT AEMPS 4.4",
          "evidencia": "revision",
          "revisado": true
        }
      ],
      "equilibrio": [
        {
          "nivel": "info",
          "texto": "Sin limitación.",
          "fuente": "FT AEMPS 4.4",
          "evidencia": "revision",
          "revisado": true
        }
      ],
      "fuentes": [
        "Ficha técnica AEMPS",
        "Guía NICE TDAH 2018"
      ]
    },
    {
      "id": "anticolinesterasicos",
      "nombre": "Fármacos para la demencia (donepezilo, rivastigmina, galantamina, memantina)",
      "atc": [
        "N06DA",
        "N06DX01"
      ],
      "resumen": "Los anticolinesterásicos frenan el pulso y pueden dar mareo y desmayos; la memantina es más neutra. El ejercicio supervisado mejora la función y reduce caídas en personas con deterioro cognitivo.",
      "senales": [
        "bradicardia",
        "caidas",
        "hipotension"
      ],
      "principios": [
        {
          "id": "donepezilo",
          "nombre": "Donepezilo",
          "marcas": [
            "Aricept"
          ],
          "umbral_mg": {
            "alta": 10
          }
        },
        {
          "id": "rivastigmina",
          "nombre": "Rivastigmina (oral o parche)",
          "marcas": [
            "Exelon",
            "Prometax"
          ],
          "umbral_mg": {
            "alta": 9.5
          }
        },
        {
          "id": "galantamina",
          "nombre": "Galantamina",
          "marcas": [
            "Reminyl"
          ],
          "umbral_mg": {
            "alta": 16
          }
        },
        {
          "id": "memantina",
          "nombre": "Memantina",
          "marcas": [
            "Ebixa",
            "Axura"
          ],
          "umbral_mg": {
            "alta": 20
          },
          "senales_extra": []
        }
      ],
      "general": [
        {
          "nivel": "precaucion",
          "texto": "Donepezilo, rivastigmina y galantamina pueden frenar el pulso y provocar mareo o desmayo, sobre todo combinados con betabloqueantes. Si hay desmayos, consulte antes de continuar el programa.",
          "fuente": "FT AEMPS 4.4",
          "evidencia": "ft",
          "revisado": true
        },
        {
          "nivel": "info",
          "texto": "El ejercicio debe hacerse acompañado y con instrucciones sencillas y repetidas. Caminar, ejercicios de fuerza sentado-de pie y equilibrio con apoyo son los más útiles.",
          "fuente": "FT AEMPS 4.4",
          "evidencia": "ft",
          "revisado": true
        }
      ],
      "aerobico": [
        {
          "nivel": "info",
          "texto": "Caminar a diario, acompañado, en entornos conocidos. Intensidad por sensación de esfuerzo.",
          "fuente": "ACSM GETP 11.ª ed., ap. A",
          "evidencia": "guia",
          "revisado": true
        }
      ],
      "fuerza": [
        {
          "nivel": "info",
          "texto": "Levantarse de la silla, subir escalones, ejercicios con bandas: 2–3 veces por semana con supervisión.",
          "fuente": "FT AEMPS 4.4",
          "evidencia": "ft",
          "revisado": true
        }
      ],
      "equilibrio": [
        {
          "nivel": "alerta",
          "texto": "Riesgo de caída alto: equilibrio siempre con apoyo y supervisión; revise calzado e iluminación de la casa.",
          "fuente": "FT AEMPS 4.4",
          "evidencia": "ft",
          "revisado": true
        }
      ],
      "fuentes": [
        "Criterios Beers 2023",
        "Guía SEN demencia"
      ]
    },
    {
      "id": "triptanes",
      "nombre": "Triptanes (sumatriptán, rizatriptán, zolmitriptán…)",
      "atc": [
        "N02CC"
      ],
      "resumen": "Tratamiento de la crisis de migraña. Contraen los vasos: no deben usarse si hay cardiopatía isquémica, y conviene no entrenar intensamente justo después de una toma.",
      "senales": [
        "hipertension"
      ],
      "principios": [
        {
          "id": "sumatriptan",
          "nombre": "Sumatriptán",
          "marcas": [
            "Imigran"
          ],
          "umbral_mg": {
            "alta": 100
          }
        },
        {
          "id": "rizatriptan",
          "nombre": "Rizatriptán",
          "marcas": [
            "Maxalt"
          ],
          "umbral_mg": {
            "alta": 10
          }
        },
        {
          "id": "zolmitriptan",
          "nombre": "Zolmitriptán",
          "marcas": [
            "Zomig"
          ],
          "umbral_mg": {
            "alta": 5
          }
        },
        {
          "id": "eletriptan",
          "nombre": "Eletriptán / almotriptán / naratriptán",
          "marcas": [
            "Relpax",
            "Almogran",
            "Naramig"
          ],
          "umbral_mg": {
            "alta": 40
          }
        }
      ],
      "general": [
        {
          "nivel": "precaucion",
          "texto": "No haga ejercicio intenso en las 2–3 horas siguientes a tomar un triptán: la combinación con el esfuerzo puede dar opresión en el pecho o subidas de tensión. Si aparece dolor torácico, consulte.",
          "fuente": "FT AEMPS 4.3",
          "evidencia": "ft",
          "revisado": true
        },
        {
          "nivel": "info",
          "texto": "El ejercicio aeróbico regular reduce la frecuencia de las migrañas. Un calentamiento progresivo y una buena hidratación evitan que el propio esfuerzo desencadene crisis.",
          "fuente": "FT AEMPS 4.3",
          "evidencia": "ft",
          "revisado": true
        },
        {
          "nivel": "alerta",
          "texto": "Si tiene angina, infarto previo o hipertensión no controlada, los triptanes están contraindicados: coméntelo con su médico.",
          "fuente": "FT AEMPS 4.3",
          "evidencia": "ft",
          "revisado": true
        }
      ],
      "aerobico": [
        {
          "nivel": "info",
          "texto": "Indicado entre crisis, con calentamiento largo. Evite el esfuerzo máximo brusco, que es desencadenante de migraña en algunas personas.",
          "fuente": "FT AEMPS 4.3",
          "evidencia": "ft",
          "revisado": true
        }
      ],
      "fuerza": [
        {
          "nivel": "info",
          "texto": "Entre crisis no hay limitación. Respire de forma continua: aguantar el aire puede provocar dolor de cabeza.",
          "fuente": "ACSM GETP 11.ª ed., ap. A",
          "evidencia": "guia",
          "revisado": true
        }
      ],
      "equilibrio": [
        {
          "nivel": "info",
          "texto": "Sin limitación.",
          "fuente": "FT AEMPS 4.3",
          "evidencia": "revision",
          "revisado": true
        }
      ],
      "fuentes": [
        "Guía SEN cefaleas 2020",
        "Amin et al. J Headache Pain 2018 (ejercicio y migraña)"
      ]
    },
