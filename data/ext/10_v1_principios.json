   "general_add": [
    {
     "nivel": "precaucion",
     "texto": "Al empezar y en cada subida de dosis produce sueño, mareo y cansancio. Evite actividades con riesgo de caída hasta saber cómo le sienta. Reduce el efecto de los anticonceptivos hormonales.",
     "si": {
