     "nombre": "Erlotinib",
     "marcas": [],
     "ficha": "https://cima.aemps.es/cima/pdfs/es/ft/83325/83325_ft.pdf"
    }
   ],
   "general_add": [
    {
     "nivel": "precaucion",
     "texto": "La diarrea es muy frecuente: beba más de lo habitual y pida tratamiento si dura más de un día. Avise si aparecen hematomas o sangrados.",
     "si": {
      "principio": "nintedanib_esilato"
     },
     "fuente": "FT AEMPS 4.8",
     "evidencia": "ft",
     "revisado": true
    },
    {
     "nivel": "precaucion",
     "texto": "Diarrea y náuseas son frecuentes al inicio: hidrátese bien y entrene a intensidad suave esos días. Puede retener líquido; si aumenta de peso de golpe o le falta el aire, consulte.",
     "si": {
      "principio": "bosutinib"
     },
     "fuente": "FT AEMPS 4.8",
     "evidencia": "ft",
     "revisado": true
    },
    {
     "nivel": "precaucion",
     "texto": "La piel se irrita y se quema con facilidad: protección solar alta, ropa que cubra y evite las horas centrales del día. La diarrea obliga a beber más.",
     "si": {
      "principio": "erlotinib"
     },
     "fuente": "FT AEMPS 4.4/4.8",
     "evidencia": "ft",
     "revisado": true
    }
   ],
   "aerobico_add": [
    {
     "nivel": "info",
     "texto": "Si lo toma por fibrosis pulmonar, la rehabilitación respiratoria y el ejercicio aeróbico suave mejoran la capacidad y el ánimo. Si usa oxígeno, entrene con él puesto y controle la saturación.",
     "si": {
      "principio": "nintedanib_esilato"
     },
     "fuente": "ATS/ERS 2022 fibrosis pulmonar idiopática",
     "evidencia": "guia",
     "revisado": true
    }
   ]
  },
