    }
   ],
   "general_add": [
    {
     "nivel": "precaucion",
     "texto": "Alarga el QT. Si nota palpitaciones o un mareo brusco durante el esfuerzo, pare y consulte. Evite la deshidratación y las pérdidas de potasio (vómitos, diarrea, diuréticos).",
     "si": {
      "principio": "ziprasidona"
     },
     "fuente": "FT AEMPS 4.4",
     "evidencia": "ft",
     "revisado": true
    },
    {
     "nivel": "info",
     "texto": "Da menos sueño y engorda menos que otros antipsicóticos. La inquietud en las piernas (acatisia) suele mejorar con actividad suave; si es intensa, coméntelo con su psiquiatra.",
     "si": {
      "principio": "lurasidona"
     },
     "fuente": "FT AEMPS 4.8",
     "evidencia": "ft",
     "revisado": true
    },
    {
     "nivel": "precaucion",
     "texto": "Alarga el QT y se elimina por el riñón: con la función renal reducida la dosis debe ser menor. Palpitaciones o mareo brusco con el esfuerzo: pare y consulte.",
     "si": {
      "principio": "amisulprida"
     },
     "fuente": "FT AEMPS 4.2/4.4",
     "evidencia": "ft",
     "revisado": true
    },
    {
     "nivel": "precaucion",
     "texto": "Produce sueño y rigidez o lentitud de movimientos, sobre todo al subir la dosis o tras la inyección de depósito. Entrene en el momento del día en que esté más despejado y evite actividades con riesgo de caída.",
     "si": {
      "principio": "zuclopentixol"
     },
     "fuente": "FT AEMPS 4.8",
     "evidencia": "ft",
     "revisado": true
    }
   ],
   "equilibrio_add": [
    {
     "nivel": "precaucion",
     "texto": "Puede dar mareo al levantarse e inquietud. Haga las transiciones despacio y el equilibrio con un apoyo cerca las primeras semanas.",
     "si": {
      "principio": "brexpiprazol"
     },
     "fuente": "FT AEMPS 4.4",
     "evidencia": "ft",
     "revisado": true
    }
   ]
  },
