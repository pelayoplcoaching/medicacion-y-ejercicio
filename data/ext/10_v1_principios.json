   "general_add": [
    {
     "nivel": "info",
     "texto": "La fluvastatina es de las estatinas con menos riesgo de daño muscular y con menos interacciones. Las señales de alarma son las mismas: dolor muscular por todo el cuerpo, debilidad u orina oscura.",
     "si": {
      "principio": "fluvastatina"
     },
     "fuente": "FT AEMPS 4.4",
     "evidencia": "ft",
     "revisado": true
    },
    {
     "nivel": "precaucion",
     "texto": "No la combine con claritromicina, itraconazol, ciclosporina ni con mucho zumo de pomelo: el riesgo de daño muscular sube mucho. Consulte antes de añadir cualquier fármaco nuevo.",
     "si": {
      "principio": "lovastatina"
     },
     "fuente": "FT AEMPS 4.3/4.5",
     "evidencia": "ft",
     "revisado": true
    }
   ]
  },
