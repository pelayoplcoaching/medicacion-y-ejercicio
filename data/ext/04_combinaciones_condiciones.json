  "clases": [
    {
      "id": "antipsicoticos_clozapina",
      "nombre": "Clozapina",
      "atc": [
        "N05AH02"
      ],
      "resumen": "Antipsicótico de uso restringido con controles de sangre. Produce sedación intensa, mareo al incorporarse, taquicardia, estreñimiento grave y, raramente, miocarditis. El ejercicio es seguro y muy recomendable para el peso y el metabolismo, con precauciones.",
      "senales": [
        "sedacion",
        "hipotension",
        "taquicardia",
        "calor",
        "caidas",
        "anticolinergico",
        "qt",
        "fc_no_valida"
      ],
      "principios": [
        {
          "id": "clozapina",
          "nombre": "Clozapina",
          "marcas": [
            "Leponex",
            "Nemea"
          ],
          "umbral_mg": {
            "alta": 300
          }
        }
      ],
      "general": [
        {
          "nivel": "alerta",
          "texto": "Dolor torácico, falta de aire o palpitaciones con fiebre, sobre todo en las primeras 8 semanas de tratamiento, pueden ser una miocarditis: no entrene y consulte de urgencia.",
          "fuente": "FT AEMPS 4.4",
          "evidencia": "ft",
          "revisado": true
        },
        {
          "nivel": "precaucion",
          "texto": "El pulso en reposo suele estar acelerado por el fármaco y no sirve para medir la intensidad; use la sensación de esfuerzo. Mareo al incorporarse frecuente.",
          "fuente": "ACSM GETP 11.ª ed., ap. A",
          "evidencia": "guia",
          "revisado": true
        },
        {
          "nivel": "precaucion",
          "texto": "Dificulta la sudoración y la regulación de la temperatura: evite el calor. El estreñimiento puede ser grave: hidratación, fibra y movimiento diario.",
          "fuente": "FT AEMPS 4.4",
          "evidencia": "ft",
          "revisado": true
        },
        {
          "nivel": "alerta",
          "texto": "Fiebre o dolor de garganta: análisis urgente (bajada de defensas por el fármaco). No entrene con esos síntomas.",
          "fuente": "FT AEMPS 4.4",
          "evidencia": "ft",
          "revisado": true
        }
      ],
      "aerobico": [
        {
          "nivel": "precaucion",
          "texto": "Intensidad ligera-moderada, en ambiente fresco, con agua. Es el mejor tratamiento contra el aumento de peso que produce el fármaco.",
          "fuente": "FT AEMPS 4.4",
          "evidencia": "ft",
          "revisado": true
        }
      ],
      "fuerza": [
        {
          "nivel": "info",
          "texto": "Muy recomendable; cargas moderadas y respiración continua.",
          "fuente": "Firth 2019 Lancet Psychiatry (salud física en enfermedad mental)",
          "evidencia": "guia",
          "revisado": true
        }
      ],
      "equilibrio": [
        {
          "nivel": "precaucion",
          "texto": "Sedación e hipotensión: con apoyo, alejado de la toma nocturna.",
          "fuente": "FT AEMPS 4.4",
          "evidencia": "ft",
          "revisado": true
        }
      ],
      "fuentes": [
        "Ficha técnica AEMPS",
        "Criterios Beers 2023"
      ]
    },
    {
      "id": "respiratorio_otros",
      "nombre": "Teofilina, montelukast y roflumilast",
      "atc": [
        "R03DA04",
        "R03DC03",
        "R03DX07"
      ],
      "resumen": "Otros fármacos respiratorios. La teofilina acelera el pulso y tiene poco margen de seguridad: el café, las infecciones y algunos antibióticos la alteran. Montelukast y roflumilast no afectan al ejercicio.",
      "senales": [],
      "principios": [
        {
          "id": "teofilina",
          "nombre": "Teofilina",
          "marcas": [
            "Theo-Dur",
            "Teromol",
            "Elixifilin"
          ],
          "umbral_mg": {
            "alta": 600
          },
          "senales_extra": [
            "taquicardia",
            "fc_no_valida",
            "qt"
          ]
