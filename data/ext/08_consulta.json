          "fuente": "FT AEMPS 4.4",
          "evidencia": "ft",
          "revisado": true
        },
        {
          "nivel": "info",
          "texto": "Caminar suave puede ayudar con la congestión; nada intenso hasta que desaparezcan los síntomas.",
          "fuente": "FT AEMPS 4.4",
          "evidencia": "ft",
          "revisado": true
        }
      ],
      "fuerza": [
        {
          "nivel": "info",
          "texto": "Sin limitación propia del fármaco; posponga las sesiones exigentes hasta recuperarse de la infección.",
          "fuente": "FT AEMPS 4.4",
          "evidencia": "revision",
          "revisado": true
        }
      ],
